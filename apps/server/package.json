{
  "name": "@shinan/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "shinan": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "NODE_ENV=development tsx watch --conditions=@shinan/source src/cli.ts web",
    "migrate": "tsx --conditions=@shinan/source src/cli.ts migrate",
    "start": "NODE_ENV=production node dist/cli.js web",
    "typecheck": "tsc --noEmit",
    "worker": "tsx --conditions=@shinan/source src/cli.ts worker"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/server": "^2.4.0",
    "@shinan/api-client": "workspace:*",
    "@shinan/core": "workspace:*",
    "@shinan/db": "workspace:*",
    "@shinan/email": "workspace:*",
    "better-auth": "1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pg-boss": "^12.38.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0"
  }
}
