# Settings for deploy/compose.yml that are not secret. Copy this file to .env
# next to compose.yml and fill it in; docs/operator-guide.md explains each.
# Secrets never go here: they are files in ./secrets.

# The Shinan image, pinned by digest.
SHINAN_IMAGE=cr.guneet.dev/shinan/shinan:v0.1.0@sha256:<index digest>

# The installation's public address: https, no path.
SHINAN_URL=https://shinan.example.com

# Installation operators' email addresses, separated by commas.
SHINAN_OPERATORS=you@example.com

# The address of your reverse proxy as Shinan sees it, so Shinan reads the
# visitor's address from X-Forwarded-For. Empty trusts no proxy.
SHINAN_TRUSTED_PROXIES=

# Port on 127.0.0.1 where your reverse proxy reaches Shinan.
SHINAN_PORT=3000

# The web container's memory limit. See the operator guide.
SHINAN_WEB_MEMORY=1536m

# Email through AWS SES.
EMAIL_FROM=shinan@example.com
EMAIL_FROM_NAME=Shinan
SES_REGION=us-east-1
SES_CONFIGURATION_SET=

# GitHub sign-in (optional): uncomment both lines, and see the guide.
# COMPOSE_FILE=compose.yml:compose.github.yml
# GITHUB_CLIENT_ID=
